<style>
:root {
    --night-blue:#0b1120; --slate-grey:#334155; --light-grey:#f8fafc;
    --optical-white:#fff; --accent:#1e3a8a; --text-primary:#1e293b;
    --text-secondary:#475569; --text-light:#cbd5e1; --paper-bg:#fdfbf7;
    --gold-accent:#b8935a;
}
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family:'Roboto',sans-serif; background:var(--paper-bg); color:var(--text-primary); line-height:1.8; font-size:1.15rem; }
h1,h2,h3,h4,h5,h6,.brand { font-family:'Montserrat',sans-serif; }
.serif-heading { font-family:'Playfair Display',serif; }
.container { max-width:1200px; margin:0 auto; padding:0 2rem; }
.article-container { max-width:800px; margin:0 auto; padding:0 2rem; }
header { background:var(--optical-white); border-bottom:2px solid var(--night-blue); padding:1rem 0; position:sticky; top:0; z-index:1000; }
.header-inner { display:flex; justify-content:space-between; align-items:center; }
.brand h1 { font-size:1.8rem; color:var(--night-blue); font-weight:800; letter-spacing:1px; display:flex; align-items:center; gap:10px; }
.brand-logo { height:40px; width:auto; }
.brand p { font-size:.65rem; color:var(--slate-grey); text-transform:uppercase; letter-spacing:2px; font-weight:600; margin-top:2px; }
.desktop-nav { display:flex; gap:2rem; align-items:center; }
.desktop-nav a { text-decoration:none; color:var(--night-blue); font-weight:600; font-family:'Montserrat',sans-serif; font-size:.9rem; text-transform:uppercase; letter-spacing:1px; }
.desktop-nav a:hover,.desktop-nav a.active { color:var(--gold-accent); }
.back-nav { padding:2rem 0; }
.back-nav a { text-decoration:none; color:var(--slate-grey); font-family:'Montserrat',sans-serif; font-size:.9rem; font-weight:600; text-transform:uppercase; letter-spacing:1px; }
.article-header { text-align:center; margin-bottom:4rem; }
.article-category { color:var(--gold-accent); text-transform:uppercase; font-weight:700; font-family:'Montserrat',sans-serif; font-size:.9rem; letter-spacing:2px; margin-bottom:1.5rem; display:block; }
.article-title { font-size:3.5rem; color:var(--night-blue); line-height:1.1; margin-bottom:2rem; }
.article-abstract { font-size:1.5rem; color:var(--slate-grey); font-family:'Playfair Display',serif; font-style:italic; max-width:90%; margin:0 auto 3rem; line-height:1.5; }
.article-meta { display:flex; justify-content:center; align-items:center; gap:2rem; flex-wrap:wrap; font-family:'Montserrat',sans-serif; font-size:.9rem; color:var(--slate-grey); text-transform:uppercase; letter-spacing:1px; border-top:1px solid #e2e8f0; border-bottom:1px solid #e2e8f0; padding:1rem 0; }
.meta-author { font-weight:700; color:var(--night-blue); }
.article-figure { margin:0 0 4rem; }
.article-hero { width:100%; height:60vh; min-height:400px; object-fit:cover; object-position:center 45%; display:block; box-shadow:0 20px 25px -5px rgba(0,0,0,.1); background:linear-gradient(135deg,#dbe4ef,#8ca0bb); }
.article-image-caption { max-width:800px; margin:1rem auto 0; padding:0 2rem; font-size:.85rem; color:var(--text-secondary); line-height:1.5; }
.article-body p { margin-bottom:2rem; text-align:justify; }
.article-body h2 { font-size:2rem; color:var(--night-blue); margin:3.5rem 0 1.5rem; font-family:'Playfair Display',serif; line-height:1.2; }
.article-body strong { font-weight:700; }
.article-body em { font-style:italic; }
.dropcap { font-size:3rem; float:left; line-height:1; padding-right:.8rem; font-family:'Playfair Display',serif; color:var(--night-blue); }
.source-note { margin-top:4rem; padding:1.5rem 1.75rem; background:rgba(184,147,90,.08); border-left:4px solid var(--gold-accent); font-size:.95rem; color:var(--text-secondary); }
.source-note p { margin:0; text-align:left; }
.source-note a,.article-body a { color:var(--accent); font-weight:600; text-decoration:underline; text-underline-offset:2px; }
.author-box { margin-top:6rem; padding:3rem; background:var(--optical-white); border:1px solid #e2e8f0; border-left:4px solid var(--gold-accent); display:flex; gap:2rem; align-items:center; }
.author-box img { width:80px; height:80px; border-radius:50%; object-fit:cover; background:#e2e8f0; }
.author-info h4 { font-size:1.2rem; color:var(--night-blue); margin-bottom:.5rem; }
.author-info p { font-size:.95rem; color:var(--text-secondary); margin:0; line-height:1.5; text-align:left; }
footer { background:var(--night-blue); color:var(--text-light); text-align:center; padding:3rem 0; font-size:.9rem; margin-top:6rem; }
@media (max-width:900px) {
    body { overflow-x:hidden; }
    .desktop-nav { display:none; }
    .article-title { font-size:2.5rem; }
    .article-abstract { font-size:1.2rem; }
    .article-hero { height:40vh; min-height:280px; }
    .article-container { padding:0 1.5rem; }
    .author-box { flex-direction:column; text-align:center; }
    .author-info p { text-align:center; }
}

.article-figure picture { display:block; }
</style>
</head>
